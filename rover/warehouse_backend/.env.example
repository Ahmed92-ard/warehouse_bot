# Copy to a protected environment file outside version control. Never commit real tokens.
MARS_MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MARS_MONGODB_DATABASE=mars_warehouse
MARS_MONGODB_DBPATH=~/.local/share/mars-warehouse/mongodb
MARS_CUSTOMER_API_TOKEN=replace-with-long-random-customer-token
MARS_OPERATOR_API_TOKEN=replace-with-long-random-operator-token
MARS_ADMIN_API_TOKEN=replace-with-long-random-admin-token
MARS_ROBOT_API_TOKEN=replace-with-long-random-robot-token
MARS_ALLOWED_ORIGINS=http://localhost:5173
